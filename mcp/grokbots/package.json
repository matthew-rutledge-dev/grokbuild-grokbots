{
  "name": "grokbots-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server: wake a Grok Bot or send it a prompt through its webhook-triggered routine (confirm-gated; GROKBOTS_READ_ONLY on hides writes)",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node ./node_modules/tsx/dist/cli.mjs src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/env.test.ts test/roster.test.ts test/stdio.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "main": "dist/index.js"
}
