{
  "mcpServers": {
    "grokbots": {
      "command": "node",
      "args": [
        "${GROK_PLUGIN_ROOT}/mcp/grokbots/dist/index.js"
      ],
      "cwd": "${GROK_PLUGIN_ROOT}/mcp/grokbots",
      "env": {
        "GROKBOTS_WEBHOOK_URL": "${GROKBOTS_WEBHOOK_URL}",
        "GROKBOTS_WEBHOOK_KEY": "${GROKBOTS_WEBHOOK_KEY}",
        "GROKBOTS_DEFAULT_BOT": "${GROKBOTS_DEFAULT_BOT}",
        "GROKBOTS_ROSTER_FILE": "${GROKBOTS_ROSTER_FILE}",
        "GROKBOTS_SENDER": "${GROKBOTS_SENDER}",
        "GROKBOTS_READ_ONLY": "${GROKBOTS_READ_ONLY}",
        "GROKBOTS_BRIDGE_URL": "${GROKBOTS_BRIDGE_URL}",
        "GROKBOTS_BRIDGE_KEY": "${GROKBOTS_BRIDGE_KEY}",
        "GROKBOTS_BRIDGE_DEFAULT_BOT": "${GROKBOTS_BRIDGE_DEFAULT_BOT}",
        "GROKBOTS_WAIT_SEC": "${GROKBOTS_WAIT_SEC}",
        "GROKBOTS_WAIT_MAX_SEC": "${GROKBOTS_WAIT_MAX_SEC}"
      }
    }
  }
}
